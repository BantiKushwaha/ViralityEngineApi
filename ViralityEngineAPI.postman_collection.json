					"name": "Add Bot Comment",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"postId\": 1,\n    \"authorId\": 1,\n    \"authorType\": \"bot\",\n    \"content\": \"Thanks for sharing!\",\n    \"depthLevel\": 2\n}"
