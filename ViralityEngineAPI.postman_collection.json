{
	"info": {
		"_postman_id": "virality-engine-api",
		"name": "Virality Engine API",
		"description": "Postman collection for Virality Engine API endpoints with Redis guardrails",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Users",
			"item": [
				{
					"name": "Create User",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"userName\": \"john_doe\",\n    \"isPremium\": false\n}"
						},
						"url": {
							"raw": "http://localhost:8080/api/user",
							"protocol": "http",
							"host": ["localhost"],
							"port": "8080",
							"path": ["api", "user"]
						}
					}
				},
				{
					"name": "Get User",
					"request": {
						"method": "GET",
						"url": {
							"raw": "http://localhost:8080/api/user?id=1",
							"protocol": "http",
							"host": ["localhost"],
							"port": "8080",
							"path": ["api", "user"],
							"query": [
								{
									"key": "id",
									"value": "1"
								}
							]
						}
					}
				}
			]
		},
		{
			"name": "Bots",
