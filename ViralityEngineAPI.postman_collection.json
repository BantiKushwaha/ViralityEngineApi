		},
		{
			"name": "Test Scenarios",
			"item": [
				{
					"name": "Test Bot Reply Limit (Should fail after 100)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"postId\": 1,\n    \"authorId\": 1,\n    \"authorType\": \"bot\",\n    \"content\": \"Bot reply test\",\n    \"depthLevel\": 1\n}"
						},
						"url": {
							"raw": "http://localhost:8080/api/comment",
							"protocol": "http",
							"host": ["localhost"],
							"port": "8080",
							"path": ["api", "comment"]
						},
						"description": "Test the horizontal cap - send this request 101 times to verify Redis guardrails stop at exactly 100 bot replies"
					}
				},
				{
					"name": "Test Comment Depth Limit",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"postId\": 1,\n    \"authorId\": 1,\n    \"authorType\": \"bot\",\n    \"content\": \"Deep comment\",\n    \"depthLevel\": 21\n}"
						},
						"url": {
							"raw": "http://localhost:8080/api/comment",
							"protocol": "http",
							"host": ["localhost"],
							"port": "8080",
							"path": ["api", "comment"]
						},
						"description": "Test the vertical cap - this should fail with depth level 21 (max is 20)"
					}
				}
			]
		}
